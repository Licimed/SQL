                <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT '02' AS REG,
 TO_CHAR(CAB.DTENTSAI,'DDMMYYYY') as DTVENC,
 TO_CHAR(CAB.DTFATUR,'DDMMYYYY') as DTFATUR,
 TO_CHAR(CAB.DTFATUR,'HH24MISS') AS HDFATUR,
 TO_CHAR(CAB.DHPROTOC,'DDMMYYYY') AS DTAPROV,
