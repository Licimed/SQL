  CAB.CHAVENFE,
  COALESCE( AD_CNPJENTREGA,  PAR.CGC_CPF ) AD_CNPJENTREGA, 
  COALESCE( AD_VERLAYOUT , '32') AS LAYOUTPHARMA , 
  COALESCE(CAB.AD_NROPEDOL,'') AS AD_NROPEDPHARMA,
  CAB.AD_NROPEDCOMPRADOR,
  to_char(sysdate,'YYYYMMDDHH24MISS') as DTHRARQ
FROM TGFCAB CAB
  INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
  INNER JOIN TSIEMP EMP ON EMP.CODEMP = CAB.CODEMP]]></COMSELECT>
            <COLUNAS>
