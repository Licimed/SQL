            <NOMEARQ><![CDATA['ACH'+Dados_Disp.EMPCGC+'P'+Dados_Disp.AD_NROPEDPHARMA+'D'+Dados_Disp.DTARQ+'.RET']]></NOMEARQ>
            <COMSELECT><![CDATA[SELECT
  '01' AS REG,
  PAR.CGC_CPF AS PARCGC,
  COALESCE( AD_CNPJENTREGA,  PAR.CGC_CPF ) DESCGC,
  EMP.CGC AS EMPCGC,
  CAB.NUNOTA,
  to_char(SYSDATE,'YYYYMMDDHH24MISS') as DTARQ,
  COALESCE(CAB.AD_NROPEDOL,'00000') AS AD_NROPEDPHARMA,
  TO_CHAR(SYSDATE,'DDMMYYYY') AS DTTITULO,
  TO_CHAR(SYSDATE,'HH24MI') AS HRTITULO
FROM TGFCAB CAB
  JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
  JOIN TSIEMP EMP ON EMP.CODEMP = CAB.CODEMP
  JOIN TGFEMP CEMP ON CEMP.CODEMP=CAB.CODEMP]]></COMSELECT>
