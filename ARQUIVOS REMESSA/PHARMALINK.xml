              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[ITENS DA NOTA]]></TITULO>
                <FILTRO><![CDATA[ITE.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT  '03' AS REG, PRO.REFERENCIA
     , PRO.CODPROD CODDIST
     , ITE.AD_EANOL CODPLK
     , SUM(ITE.QTDNEG) AS QTDNEG
     , ITE.CODVOL 
     , SUM(IT.VLRUNIT) AS VALORLIQ
     , SUM(IT.PERCDESC) AS PERCDESC
     , SUM(IT.VLRDESC) AS VLRDESC
     , SUM((ITE.VLRTOT - ITE.VLRDESC)/ITE.QTDNEG) AS VLRUNIT
     , CASE WHEN (PRO.CODVOL = ITE.CODVOL) THEN SUM(ITE.QTDNEG)
            ELSE (CASE WHEN VOA.DIVIDEMULTIPLICA = 'D' THEN SUM(ITE.QTDNEG * QUANTIDADE) ELSE SUM(ITE.QTDNEG / QUANTIDADE) END)
       END AS FRACIONAMENTO,
        SUM(round((ITE.VLRDESC / ITE.QTDNEG) + ITE.VLRUNIT,2)) VALORBRUTOUNIT, 
		SUM(round(ITE.VLRDESC / ITE.QTDNEG,2)) VALORDESCUNIT ,
SUM(round(((ITE.VLRDESC / ITE.QTDNEG) + ITE.VLRUNIT) * ITE.QTDNEG,2)) VALORBRUTOLINHA,
SUM(ITE.VLRTOT)  VALORTOT
  FROM TGFITE ITE
  INNER JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
  INNER JOIN TGFVAR VR ON VR.NUNOTA = ITE.NUNOTA AND VR.SEQUENCIA = ITE.SEQUENCIA
  INNER JOIN TGFITE IT ON IT.NUNOTA = VR.NUNOTAORIG AND IT.SEQUENCIA = VR.SEQUENCIAORIG
   LEFT JOIN TGFVOA VOA ON VOA.CODPROD = PRO.CODPROD AND VOA.CODVOL = PRO.CODVOL]]></COMSELECT>
                <COMGROUPBY><![CDATA[PRO.REFERENCIA
     , PRO.CODPROD
     , ITE.AD_EANOL
     , PRO.CODVOL,
     ITE.CODVOL,VOA.DIVIDEMULTIPLICA]]></COMGROUPBY>
