  TO_CHAR(NVL(MOT.NUCANCEL, 6)) AS NUCANCEL
FROM AD_TGFCAN CAN
JOIN AD_TGFITECAN ITE ON ITE.NUNOTA=CAN.NUNOTA
JOIN TGFPRO PRO ON PRO.CODPROD=ITE.CODPROD
LEFT JOIN AD_MOTCAN MOT ON (CASE WHEN ITE.NUCANCEL IS NOT NULL 
THEN ITE.NUCANCEL ELSE CAN.NUCANCEL END) = MOT.NUCANCEL
