              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[TOTAIS DO PEDIDO RESPOSTA]]></TITULO>
                <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT
  COUNT(ITE.SEQUENCIA) AS QTDLINHAS,
  REPLACE(SUM(ITE.QTDNEG) - SUM(ITE.QTDCONFERIDA),'.','') AS SOMAUNIDATEND,
  REPLACE(TO_CHAR(SUM(ITE.QTDCONFERIDA) + NVL(REC.QTDRECUSADA, 0)),'.','') AS SOMAUNIDCORTE
FROM TGFITE ITE
  JOIN TGFCAB CAB ON CAB.NUNOTA = ITE.NUNOTA
  JOIN TGFEMP CEMP ON CEMP.CODEMP=CAB.CODEMP
  LEFT JOIN (SELECT SUM(QTDNEG) AS QTDRECUSADA, NUNOTA FROM AD_PRORECINT GROUP BY NUNOTA) REC ON REC.NUNOTA = CAB.NUNOTA]]></COMSELECT>
