              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[ITENS DO PEDIDO RESPOSTA]]></TITULO>
                <FILTRO><![CDATA[NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT 
    NUNOTA,
    REFERENCIA,
    CODPROD,
    SUM(QTDNEG) AS QTDNEG,
    SUM(QTDCORTE) AS QTDCORTE,
    CODVOL,
    MOTIVORECUSA,
    STATUSITEM
FROM (
        SELECT 
        CAB.NUNOTA,
        PRO.REFERENCIA,
        TO_CHAR(ITE.CODPROD) AS CODPROD,
        TO_CHAR(ITE.QTDNEG - ITE.QTDCONFERIDA) AS QTDNEG,
        TO_CHAR(ITE.QTDCONFERIDA) AS QTDCORTE,
        ITE.CODVOL,
        CASE 
            WHEN ITE.QTDNEG > (ITE.QTDNEG - ITE.QTDCONFERIDA) 
                 AND (ITE.QTDNEG - ITE.QTDCONFERIDA) > 0 THEN '07'
            WHEN ITE.QTDNEG > (ITE.QTDNEG - ITE.QTDCONFERIDA) 
                 AND (ITE.QTDNEG - ITE.QTDCONFERIDA) = 0 THEN '06'
            ELSE '00' 
        END AS MOTIVORECUSA,
        CASE 
            WHEN ITE.QTDNEG > (ITE.QTDNEG - ITE.QTDCONFERIDA) 
                 AND (ITE.QTDNEG - ITE.QTDCONFERIDA) > 0 THEN '02'
            WHEN ITE.QTDNEG > (ITE.QTDNEG - ITE.QTDCONFERIDA) 
                 AND (ITE.QTDNEG - ITE.QTDCONFERIDA) = 0 THEN '03'
            ELSE '01' 
        END AS STATUSITEM
    FROM TGFITE ITE
    JOIN TGFPRO PRO   ON PRO.CODPROD = ITE.CODPROD
    JOIN TGFCAB CAB   ON CAB.NUNOTA = ITE.NUNOTA
    JOIN TGFEMP CEMP  ON CEMP.CODEMP = CAB.CODEMP

    UNION ALL

    SELECT
        CAB.NUNOTA,
        REC.REFERENCIA,
        '0'     AS CODPROD,
        '0'     AS QTDNEG,
        TO_CHAR(REC.QTDNEG) AS QTDCORTE,
        'UN'    AS CODVOL,
        '06'    AS MOTIVORECUSA,
        '03'    AS STATUSITEM
    FROM TGFCAB CAB
    JOIN AD_PRORECINT REC ON REC.NUNOTA = CAB.NUNOTA
)]]></COMSELECT>
                <COMGROUPBY><![CDATA[NUNOTA,REFERENCIA,CODPROD,CODVOL,MOTIVORECUSA,STATUSITEM]]></COMGROUPBY>
