<?xml version="1.0" encoding="ISO-8859-1"?>
<LAYOUTS MODULO="C" QUANTIDADE="1" TIPO="Remessa">
  <LAYOUT PROFUNDIDADE="4" ANALITICO="N" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
    <TITULO><![CDATA[IQVIA - TAKEDA VERSÃO FINAL]]></TITULO>
    <LINHAS QUANTIDADE="1">
      <LINHA ANALITICO="N" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
        <TITULO><![CDATA[INTEGRACAO TAKEDA]]></TITULO>
        <LINHAS QUANTIDADE="4">
          <LINHA ANALITICO="N" ORDENAR="N" FICHA="N" ARQPORLINHA="S" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
            <TITULO><![CDATA[RETORNO PEDIDO]]></TITULO>
            <FILTRO><![CDATA[CAB.TIPMOV = 'P' AND CAB.STATUSNOTA = 'L' 
AND CAB.CODTIPOPER IN  (1010,1030) 
AND NVL( CAB.AD_STATUSOL, 'S') = 'Aceito'
AND AD_NUINTEGRACAO = 3
AND EXISTS ( SELECT 1 FROM AD_VWITENS_IQVIA 
    where 
    NUNOTA = CAB.NUNOTA OR
    ( NUNOTA IN ( SELECT NUNOTAORIG FROM TGFVAR WHERE NUNOTA =  CAB.NUNOTA ) AND MOTIVORECUSA <> '00' )
)
AND CAB.NUNOTA IN (SELECT MAX(CAB2.NUNOTA) FROM TGFCAB CAB2 WHERE CAB2.AD_NROPEDPHARMA = CAB.AD_NROPEDPHARMA )]]></FILTRO>
            <NOMEARQ><![CDATA['RETN'+Dados_Disp.SIGLA+'_'+Dados_Disp.CGC+'_'+Dados_Disp.AD_NROPEDPHARMA+'.RET']]></NOMEARQ>
            <COMSELECT><![CDATA[SELECT
  '1' AS REG,
  PAR.CGC_CPF AS PAR_CGC,
  EMP.CGC,
  CAB.NUNOTA,
  CAB.AD_SIGLAOL AS SIGLA,
  COALESCE(CAB.AD_NROPEDPHARMA,'') AS AD_NROPEDPHARMA
FROM TGFCAB CAB
  INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
  INNER JOIN TSIEMP EMP ON EMP.CODEMP = CAB.CODEMP]]></COMSELECT>
            <COLUNAS>
              <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="E" QTDDEC="0">
                <CAMPO><![CDATA[Dados_Disp.REG]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="2" TAMANHO="14" TIPO="F" QTDDEC="0">
                <CAMPO><![CDATA[Dados_Disp.PAR_CGC]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="3" TAMANHO="1" TIPO="E">
                <CAMPO><![CDATA['']]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="4" TAMANHO="15" TIPO="F" QTDDEC="0">
                <CAMPO><![CDATA[Dados_Disp.AD_NROPEDPHARMA]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="5" TAMANHO="2" TIPO="C" QTDDEC="0">
                <CAMPO><![CDATA[00]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="6" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
              </COLUNA>
            </COLUNAS>
            <LINHAS QUANTIDADE="3">
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[DADOS DO PEDIDO]]></TITULO>
                <FILTRO><![CDATA[NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT '2' AS REG  
   , REPLACE(TO_CHAR(DTFATUR,'DD/MM/YYYY'),'/','') AS DTFATUR
   , REPLACE(TO_CHAR(DTFATUR,'HH24:MI:SS'),':','') AS HRFATUR 
  FROM TGFCAB]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.REG]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="8" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.DTFATUR]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="6" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[REPLACESTRING(Dados_Disp.HRFATUR,':','')]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="10" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[0]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[ITENS DO PEDIDO]]></TITULO>
                <FILTRO><![CDATA[SUB.NUNOTA = [NUNOTA] OR
( SUB.NUNOTA IN ( SELECT NUNOTAORIG FROM TGFVAR WHERE NUNOTA = [NUNOTA] ) AND MOTIVORECUSA <> '00' )]]></FILTRO>
                <COMSELECT><![CDATA[SELECT NUNOTA, SEQUENCIA, REFERENCIA,QTD, QTDNEG,QTDCORTE,MOTIVORECUSA,STATUSITEM FROM AD_VWITENS_IQVIA SUB]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[3]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="13" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.REFERENCIA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.QTDNEG]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.QTDCORTE]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="2" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.MOTIVORECUSA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="1" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.STATUSITEM]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="7" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[TOTAIS DO PEDIDO]]></TITULO>
                <FILTRO><![CDATA[(  ( SUB.NUNOTA = [NUNOTA] )
			OR
		  ( SUB.NUNOTA IN ( SELECT NUNOTAORIG FROM TGFVAR WHERE TGFVAR.NUNOTA = [NUNOTA] ) AND SUB.MOTIVORECUSA <> '00' ) 
	   )]]></FILTRO>
                <COMSELECT><![CDATA[SELECT COUNT(1) AS QTDLINHAS
     , REPLACE(SUM(QTDNEG),'.','') AS SOMAUNIDATEND
     , REPLACE(SUM(QTDCORTE),'.','') AS SOMAUNIDCORTE 
  FROM (
  SELECT NUNOTA, SEQUENCIA, REFERENCIA,QTD, QTDNEG,QTDCORTE,MOTIVORECUSA,STATUSITEM FROM AD_VWITENS_IQVIA
)  SUB]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[4]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.SOMAUNIDATEND]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.SOMAUNIDCORTE]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.QTDLINHAS]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="12" TIPO="E">
                    <CAMPO><![CDATA['']]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
            </LINHAS>
          </LINHA>
          <LINHA ANALITICO="N" ORDENAR="N" FICHA="N" ARQPORLINHA="S" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
            <TITULO><![CDATA[RETORNO NOTA FISCAL]]></TITULO>
            <FILTRO><![CDATA[CAB.STATUSNOTA = 'L' 
AND CAB.CODTIPOPER = 1100
AND CAB.STATUSNFE IN( 'A','S') 
AND NVL(CAB.AD_STATUSOL,'') NOT IN ('NFeEnviada', 'Concluido')
AND AD_NUINTEGRACAO = 3]]></FILTRO>
            <NOMEARQ><![CDATA['NOT'+Dados_Disp.SIGLA+'_'+Dados_Disp.CGC+'_'+Dados_Disp.AD_NROPEDPHARMA+'.NOT']]></NOMEARQ>
            <COMSELECT><![CDATA[SELECT
 '1' AS REG,
  REPLACE(TO_CHAR(SYSTIMESTAMP,'DD/MM/YYYY'),'/','') AS DTTITULO,
  REPLACE(TO_CHAR (SYSTIMESTAMP, 'HH24:MI:SS'),':','') AS HRTITULO,
  EMP.CGC,
  CAB.AD_SIGLAOL AS SIGLA,
  CAB.AD_NROPEDPHARMA,
  CAB.AD_NROPEDCOMPRADOR,
  CAB.NUNOTA
FROM TGFCAB CAB
  INNER JOIN TSIEMP EMP ON EMP.CODEMP = CAB.CODEMP
  INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC]]></COMSELECT>
            <COLUNAS>
              <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="A" QTDDEC="0">
                <CAMPO><![CDATA[Dados_Disp.REG]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="2" TAMANHO="8" TIPO="C" QTDDEC="0">
                <CAMPO><![CDATA[Dados_Disp.DTTITULO]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="3" TAMANHO="6" TIPO="C" QTDDEC="0">
                <CAMPO><![CDATA[REPLACESTRING(Dados_Disp.HRTITULO,':','')]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="4" TAMANHO="14" TIPO="E" QTDDEC="0">
                <CAMPO><![CDATA[Dados_Disp.CGC]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="5" TAMANHO="1" TIPO="E">
                <CAMPO><![CDATA['']]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="6" TAMANHO="15" TIPO="C" QTDDEC="0">
                <CAMPO><![CDATA[Dados_Disp.AD_NROPEDPHARMA]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="7" TAMANHO="15" TIPO="C" QTDDEC="0">
                <CAMPO><![CDATA[Dados_Disp.AD_NROPEDCOMPRADOR]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="8" TAMANHO="20" TIPO="E">
                <CAMPO><![CDATA[""]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="9" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
              </COLUNA>
            </COLUNAS>
            <LINHAS QUANTIDADE="5">
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[DADOS NOTA FISCAL]]></TITULO>
                <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT
  REPLACE(TO_CHAR (CAB.DTFATUR,'DD/MM/YYYY'),'/','') AS DTFATUR,
  REPLACE(TO_CHAR (CAB.DTENTSAI,'DD/MM/YYYY'),'/','') AS DTENTSAI,
  REPLACE(TO_CHAR (CAB.HRENTSAI,'HH24:MI:SS'),':','') AS HRENTSAI, 
  PAR.CGC_CPF AS CGC_CLIENTE,
  CAB.NUMNOTA,
  CAB.SERIENOTA,
  MAX(ITE.CODCFO) AS CODCFO,
  CAB.CHAVENFE ,
  REPLACE(TO_CHAR((SELECT MAX(DTVENC) FROM TGFFIN FIN WHERE FIN.NUNOTA = CAB.NUNOTA),'DD/MM/YYYY'),'/','') AS DTVENC
FROM TGFCAB CAB
INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
INNER JOIN TGFITE ITE ON ITE.NUNOTA = CAB.NUNOTA]]></COMSELECT>
                <COMGROUPBY><![CDATA[REPLACE(TO_CHAR (CAB.DTFATUR,'DD/MM/YYYY'),'/',''),
  REPLACE(TO_CHAR (CAB.DTENTSAI,'DD/MM/YYYY'),'/',''),
  REPLACE(TO_CHAR (CAB.HRENTSAI,'HH24:MI:SS'),':',''), 
  PAR.CGC_CPF,
  CAB.NUMNOTA,
  CAB.SERIENOTA,
  CAB.CHAVENFE,
  CAB.NUNOTA]]></COMGROUPBY>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[2]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.DTENTSAI]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="6" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[REPLACESTRING(Dados_Disp.HRENTSAI,':','')]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.DTFATUR]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="14" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.CGC_CLIENTE]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="6" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.NUMNOTA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="7" TAMANHO="3" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.SERIENOTA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="8" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.DTVENC]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="9" TAMANHO="9" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.NUMNOTA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="10" TAMANHO="3" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.SERIENOTA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="11" TAMANHO="4" TIPO="F" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.CODCFO]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="12" TAMANHO="44" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.CHAVENFE]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="13" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[TOTAIS DA NOTA FISCAL]]></TITULO>
                <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT CAB.VLRFRETE
     , CAB.VLRSEG
     , SUM(VLRTOT - VLRDESC) AS TOTPRODUTOS
     , CAB.VLRNOTA
     , CAB.VLRIPI 
  FROM TGFCAB CAB
  INNER JOIN TGFITE ITE ON ITE.NUNOTA = CAB.NUNOTA]]></COMSELECT>
                <COMGROUPBY><![CDATA[CAB.VLRFRETE
     , CAB.VLRSEG
     , CAB.VLRNOTA
     , CAB.VLRIPI]]></COMGROUPBY>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[3]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRFRETE]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRSEG]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[0]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.TOTPRODUTOS]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRNOTA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="7" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRIPI]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="8" TAMANHO="31" TIPO="E">
                    <CAMPO><![CDATA[""]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="9" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[IMPOSTOS DA NOTA FISCAL]]></TITULO>
                <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT CAB.BASEICMS
      ,CAB.VLRICMS
      ,CAB.BASESUBSTIT 
      ,CAB.VLRSUBST
  FROM TGFCAB CAB]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[4]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.BASEICMS]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRICMS]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.BASESUBSTIT]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRSUBST]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="47" TIPO="E">
                    <CAMPO><![CDATA[""]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="7" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[ITENS DA NOTA FISCAL]]></TITULO>
                <FILTRO><![CDATA[ITE.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT PRO.REFERENCIA
     , PRO.CODPROD
     , ITE.QTDNEG
     , ITE.CODVOL 
     , IT.VLRUNIT AS PRECO
     , IT.PERCDESC
     , IT.VLRDESC
     , (ITE.VLRTOT - ITE.VLRDESC)/ITE.QTDNEG AS VLRUNIT
     , CASE WHEN (PRO.CODVOL = ITE.CODVOL) THEN ITE.QTDNEG
            ELSE (CASE WHEN VOA.DIVIDEMULTIPLICA = 'D' THEN ITE.QTDNEG * QUANTIDADE ELSE ITE.QTDNEG / QUANTIDADE END)
       END AS FRACIONAMENTO
  FROM TGFITE ITE
  INNER JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
  INNER JOIN TGFVAR VR ON VR.NUNOTA = ITE.NUNOTA AND VR.SEQUENCIA = ITE.SEQUENCIA
  INNER JOIN TGFITE IT ON IT.NUNOTA = VR.NUNOTAORIG AND IT.SEQUENCIA = VR.SEQUENCIAORIG
   LEFT JOIN TGFVOA VOA ON VOA.CODPROD = PRO.CODPROD AND VOA.CODVOL = PRO.CODVOL]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[5]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="13" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.REFERENCIA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="7" TIPO="F" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.CODPROD]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.QTDNEG]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="3" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.CODVOL]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.PRECO]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="7" TAMANHO="4" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.PERCDESC]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="8" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRDESC]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="9" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[0]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="10" TAMANHO="4" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[0]]></CAMPO>
                  </COLUNA>
