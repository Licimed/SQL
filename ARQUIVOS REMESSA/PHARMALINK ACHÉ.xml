                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[ITENS DA NOTA]]></TITULO>
                <FILTRO><![CDATA[ITE.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT PRO.REFERENCIA
     , PRO.CODPROD
     , ITE.QTDNEG
     , ITE.CODVOL 
     , IT.VLRUNIT AS PRECO
     , IT.PERCDESC
     , IT.VLRDESC
     , (ITE.VLRTOT - ITE.VLRDESC)/ITE.QTDNEG AS VLRUNIT
     , CASE WHEN (PRO.CODVOL = ITE.CODVOL) THEN ITE.QTDNEG
            ELSE (CASE WHEN VOA.DIVIDEMULTIPLICA = 'D' THEN ITE.QTDNEG * QUANTIDADE ELSE ITE.QTDNEG / QUANTIDADE END)
       END AS FRACIONAMENTO
  FROM TGFITE ITE
  INNER JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
  INNER JOIN TGFVAR VR ON VR.NUNOTA = ITE.NUNOTA AND VR.SEQUENCIA = ITE.SEQUENCIA
  INNER JOIN TGFITE IT ON IT.NUNOTA = VR.NUNOTAORIG AND IT.SEQUENCIA = VR.SEQUENCIAORIG
   LEFT JOIN TGFVOA VOA ON VOA.CODPROD = PRO.CODPROD AND VOA.CODVOL = PRO.CODVOL]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[5]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="13" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.REFERENCIA]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="7" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.CODPROD]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.QTDNEG]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="3" TIPO="E" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.CODVOL]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.PRECO]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="7" TAMANHO="4" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.PERCDESC]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="8" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRDESC]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="9" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[0]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="10" TAMANHO="4" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[0]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="11" TAMANHO="8" TIPO="A" QTDDEC="2">
                    <CAMPO><![CDATA[Dados_Disp.VLRUNIT]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="12" TAMANHO="4" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[Dados_Disp.FRACIONAMENTO]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="13" TAMANHO="4" TIPO="C" QTDDEC="0">
                    <CAMPO><![CDATA[0]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="14" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[IDENTIFICADOR DE FIM]]></TITULO>
                <FILTRO><![CDATA[ITE.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT COUNT(1) AS QTDLINHAS
  FROM TGFITE ITE]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C">
                    <CAMPO><![CDATA[6]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="4" TIPO="C">
                    <CAMPO><![CDATA[Dados_Disp.QTDLINHAS]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="75" TIPO="E">
                    <CAMPO><![CDATA['']]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[DADOS DO CLIENTE]]></TITULO>
                <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT PAR.NOMEPARC
     , PAR.RAZAOSOCIAL
     , PAR.EMAIL
  FROM TGFCAB CAB
  INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C">
                    <CAMPO><![CDATA[7]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="50" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.NOMEPARC]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="50" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.RAZAOSOCIAL]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="50" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.EMAIL]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[DADOS COMPLEMENTARES]]></TITULO>
                <FILTRO><![CDATA[CAB.NUNOTA= [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT REPLACE(REPLACE(REPLACE(PAR.CEP,'.',''),'-',''),' ','') AS CEP
     , UFS.UF
     , CID.NOMECID
  FROM TGFCAB CAB
  INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
  INNER JOIN TSICID CID ON CID.CODCID = PAR.CODCID
  INNER JOIN TSIUFS UFS ON UFS.CODUF = CID.UF]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C">
                    <CAMPO><![CDATA[8]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="50" TIPO="E">
                    <CAMPO><![CDATA['']]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="8" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.CEP]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.UF]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="50" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.NOMECID]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
              <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
                <TITULO><![CDATA[ENDERECO CLIENTE]]></TITULO>
                <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
                <COMSELECT><![CDATA[SELECT SUBSTRING(ED.TIPO,1,10) AS TIPO
     , ED.NOMEEND
     , BAI.NOMEBAI
     , SUBSTRING(PAR.NUMEND,1,5) AS NUMEND
  FROM TGFCAB CAB
  INNER JOIN TGFPAR PAR ON PAR.CODPARC = CAB.CODPARC
  INNER JOIN TSIEND ED ON ED.CODEND = PAR.CODEND
  INNER JOIN TSIBAI BAI ON BAI.CODBAI = PAR.CODBAI]]></COMSELECT>
                <COLUNAS>
                  <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C">
                    <CAMPO><![CDATA[9]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="2" TAMANHO="50" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.NOMEBAI]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="3" TAMANHO="10" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.TIPO]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="4" TAMANHO="100" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.NOMEEND]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="5" TAMANHO="5" TIPO="E">
                    <CAMPO><![CDATA[Dados_Disp.NUMEND]]></CAMPO>
                  </COLUNA>
                  <COLUNA SEQUENCIA="6" TAMANHO="2" TIPO="E">
                    <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
                  </COLUNA>
                </COLUNAS>
              </LINHA>
            </LINHAS>
          </LINHA>
        </LINHAS>
      </LINHA>
    </LINHAS>
  </LAYOUT>
</LAYOUTS>

