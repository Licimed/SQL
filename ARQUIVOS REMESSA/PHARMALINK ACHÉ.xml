     , ITE.QTDNEG
     , ITE.CODVOL 
     , IT.VLRUNIT AS VALORLIQ
     , IT.PERCDESC
     , IT.VLRDESC
     , (ITE.VLRTOT - ITE.VLRDESC)/ITE.QTDNEG AS VLRUNIT
     , CASE WHEN (PRO.CODVOL = ITE.CODVOL) THEN ITE.QTDNEG
            ELSE (CASE WHEN VOA.DIVIDEMULTIPLICA = 'D' THEN ITE.QTDNEG * QUANTIDADE ELSE ITE.QTDNEG / QUANTIDADE END)
       END AS FRACIONAMENTO,
        round((ITE.VLRDESC / ITE.QTDNEG) + ITE.VLRUNIT,2) VALORBRUTOUNIT, 
		round(ITE.VLRDESC / ITE.QTDNEG,2) VALORDESCUNIT ,
round(((ITE.VLRDESC / ITE.QTDNEG) + ITE.VLRUNIT) * ITE.QTDNEG,2) VALORBRUTOLINHA,
ITE.VLRTOT  VALORTOT
  FROM TGFITE ITE
  INNER JOIN TGFPRO PRO ON PRO.CODPROD = ITE.CODPROD
  INNER JOIN TGFVAR VR ON VR.NUNOTA = ITE.NUNOTA AND VR.SEQUENCIA = ITE.SEQUENCIA
  INNER JOIN TGFITE IT ON IT.NUNOTA = VR.NUNOTAORIG AND IT.SEQUENCIA = VR.SEQUENCIAORIG
   LEFT JOIN TGFVOA VOA ON VOA.CODPROD = PRO.CODPROD AND VOA.CODVOL = PRO.CODVOL]]></COMSELECT>
