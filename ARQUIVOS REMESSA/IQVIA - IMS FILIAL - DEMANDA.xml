              </COLUNA>
              <COLUNA SEQUENCIA="4" TAMANHO="1" TIPO="C">
                <CAMPO><![CDATA[1]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="5" TAMANHO="1" TIPO="C">
                <CAMPO><![CDATA[0]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="6" TAMANHO="13" TIPO="C">
                <CAMPO><![CDATA[Dados_Disp.CODPROD]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="7" TAMANHO="1" TIPO="C">
                <CAMPO><![CDATA[1]]></CAMPO>
