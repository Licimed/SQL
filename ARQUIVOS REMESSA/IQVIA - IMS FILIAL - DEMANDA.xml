        <LINHAS QUANTIDADE="2">
          <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
            <TITULO><![CDATA[DESCRIÇÃO]]></TITULO>
            <FILTRO><![CDATA[CAB.TIPMOV IN ('V','D')
AND CAB.STATUSNFE = 'A'
AND CAB.STATUSNOTA = 'L'
AND CAB.CODPARC<>3
AND CAB.CODEMP = 3
AND TOP.GOLSINAL = -1
AND to_char(cab.dtneg,'DDMMYYYY') = to_char(sysdate, 'DDMMYYYY')]]></FILTRO>
            <COMSELECT><![CDATA[select distinct extract(DAY from CAB.DTNEG) as DIAMOV, CAB.CODPARC,
ITE.CODPROD,SUM(ITE.QTDNEG) as QTDNEG,CASE WHEN CAB.TIPMOV <> 'D' THEN 'N' ELSE CAB.TIPMOV END AS FLAG_VENDA
from TGFCAB CAB
JOIN TGFITE ITE ON ITE.NUNOTA=CAB.NUNOTA
JOIN TSIEMP EMP ON EMP.CODEMP=CAB.CODEMP
JOIN TGFPAR PAR ON PAR.CODPARC=CAB.CODPARC
JOIN TGFTOP TOP ON TOP.CODTIPOPER=CAB.CODTIPOPER AND TOP.DHALTER=CAB.DHTIPOPER]]></COMSELECT>
            <COMGROUPBY><![CDATA[extract(DAY from cab.dtneg),CAB.CODPARC,ITE.CODPROD,CASE WHEN CAB.TIPMOV <> 'D' THEN 'N' ELSE CAB.TIPMOV END]]></COMGROUPBY>
            <COLUNAS>
              <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C">
                <CAMPO><![CDATA[5]]></CAMPO>
