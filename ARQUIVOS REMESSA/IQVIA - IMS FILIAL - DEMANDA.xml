          <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
            <TITULO><![CDATA[TRAILLER]]></TITULO>
            <FILTRO><![CDATA[CAB.TIPMOV IN ('V', 'D')
AND CAB.STATUSNFE = 'A'
AND CAB.STATUSNOTA = 'L'
AND CAB.CODPARC<>3
AND CAB.CODEMP = 3
AND TOP.GOLSINAL = -1
AND to_char(cab.dtneg,'DDMMYYYY') = to_char(sysdate, 'DDMMYYYY')]]></FILTRO>
            <COMSELECT><![CDATA[SELECT COUNT(*) + 2 AS TOTREG,
		   ROUND(SUM(CASE WHEN CAB.TIPMOV = 'V' THEN ITE.QTDNEG ELSE 0 END),0) AS TOTSUM,
		   ROUND(SUM(CASE WHEN CAB.TIPMOV = 'D' AND EXISTS (SELECT COUNT(*) 
												  FROM TGFVAR V,TGFCAB C 
												 WHERE C.NUNOTA=V.NUNOTAORIG 
												   AND C.STATUSNFE = 'A' 
												   AND V.NUNOTA = CAB.NUNOTA) THEN ITE.QTDNEG ELSE 0 END), 0) AS TOTDEV
FROM TGFCAB CAB
JOIN TGFITE ITE ON ITE.NUNOTA=CAB.NUNOTA
JOIN TGFTOP TOP ON TOP.CODTIPOPER=CAB.CODTIPOPER AND TOP.DHALTER=CAB.DHTIPOPER]]></COMSELECT>
            <COMGROUPBY><![CDATA[TO_CHAR(CAB.DTNEG,'DDMMYYYY')]]></COMGROUPBY>
            <COLUNAS>
              <COLUNA SEQUENCIA="1" TAMANHO="1" TIPO="C">
                <CAMPO><![CDATA[6]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="2" TAMANHO="1" TIPO="C">
                <CAMPO><![CDATA[0]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="3" TAMANHO="4" TIPO="C">
                <CAMPO><![CDATA[1277]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="C">
                <CAMPO><![CDATA[Dados_Disp.TOTREG]]></CAMPO>
