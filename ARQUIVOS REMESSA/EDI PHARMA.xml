<?xml version="1.0" encoding="ISO-8859-1"?>
<LAYOUTS MODULO="C" QUANTIDADE="1" TIPO="Remessa">
  <LAYOUT PROFUNDIDADE="3" ANALITICO="N" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
    <TITULO><![CDATA[EDI PHARMA]]></TITULO>
    <LINHAS QUANTIDADE="1">
      <LINHA ANALITICO="N" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
        <TITULO><![CDATA[REGISTRO 00 ? CABECALHO DE ARQUIVO]]></TITULO>
        <FILTRO><![CDATA[TRUNC(CAB.AD_DHCONFIRM) = TRUNC(SYSDATE)
AND TOP.TIPMOV = 'O'
AND CAB.STATUSNOTA = 'L'
AND CAB.CODEMP IN (1,3)
AND PAR.AD_NRCTEDIPHARMA IS NOT NULL
AND TOP.AD_TIPPEDIDOEDIPHARMA IS NOT NULL
AND NVL(CAB.AD_STATUSINTEGEDIPHARMA,0) = 0]]></FILTRO>
        <NOMEARQ><![CDATA[Dados_Disp.NOME_ARQ+"_"+_NUMREG+'.TXT']]></NOMEARQ>
        <COMSELECT><![CDATA[SELECT
    'RS'||TO_CHAR(MAX(CAB.AD_DHCONFIRM),'DDMMYYHH24MI') AS NOME_ARQ,
    '00' AS TIPOREGISTRO,
'ORDERS'||TO_CHAR(MAX(CAB.AD_DHCONFIRM),'DDMM')||LPAD(AD_GET_PROX_SEQ_IQVIA(''),3,0) AS IDENTIFICACAO,
    LPAD(EMP.CGC,35,0) AS IDORIGEM ,
    LPAD(PAR.CGC_CPF,35,0) AS IDDESTINO,
MAX(PAR.CGC_CPF) AS CNPJ,
CAB.NUNOTA,
    LPAD(' ',364,' ') AS FILLER
    FROM TGFCAB CAB
    INNER JOIN TGFPAR PAR ON (PAR.CODPARC = CAB.CODPARC)
    INNER JOIN TSIEMP EMP ON (EMP.CODEMP = CAB.CODEMP)
    INNER JOIN TGFTOP TOP ON (TOP.CODTIPOPER = CAB.CODTIPOPER AND TOP.DHALTER = CAB.DHTIPOPER)]]></COMSELECT>
        <COMGROUPBY><![CDATA['OC'||LPAD(PAR.CODPARC,6,0)||TO_CHAR(CAB.AD_DHCONFIRM,'DDMMYY'),LPAD(EMP.CGC,35,0),LPAD(PAR.CGC_CPF,35,0), CAB.NUNOTA]]></COMGROUPBY>
        <COLUNAS>
          <COLUNA SEQUENCIA="1" TAMANHO="2" TIPO="E">
            <CAMPO><![CDATA[Dados_Disp.TIPOREGISTRO]]></CAMPO>
          </COLUNA>
          <COLUNA SEQUENCIA="2" TAMANHO="14" TIPO="E">
            <CAMPO><![CDATA[Dados_Disp.IDENTIFICACAO]]></CAMPO>
          </COLUNA>
          <COLUNA SEQUENCIA="3" TAMANHO="35" TIPO="E">
            <CAMPO><![CDATA[Dados_Disp.IDORIGEM]]></CAMPO>
          </COLUNA>
          <COLUNA SEQUENCIA="4" TAMANHO="35" TIPO="E">
            <CAMPO><![CDATA[Dados_Disp.IDDESTINO]]></CAMPO>
          </COLUNA>
          <COLUNA SEQUENCIA="5" TAMANHO="364" TIPO="E">
            <CAMPO><![CDATA[Dados_Disp.FILLER]]></CAMPO>
          </COLUNA>
          <COLUNA SEQUENCIA="6" TAMANHO="2" TIPO="E">
            <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
          </COLUNA>
        </COLUNAS>
        <LINHAS QUANTIDADE="3">
          <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
            <TITULO><![CDATA[REGISTRO 01 - CABEÇALHO DO PEDIDO COMPRA]]></TITULO>
            <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
            <COMSELECT><![CDATA[SELECT
'01' AS TIPOREGISTRO1,
CAB.NUNOTA AS NUNOTA,
LPAD(CAB.NUNOTA,15,0) AS IDENTIFICACAO2,
TO_CHAR(CAB.DTPREVENT,'YYYYMMDD') AS DTENTREGAFIXA3,
TO_CHAR(CAB.DTPREVENT,'YYYYMMDD') AS DTENTREGAFIM4,
TO_CHAR(CAB.DTPREVENT,'YYYYMMDD') AS DTENTREGAINI5,
TO_CHAR(CAB.DTNEG,'YYYYMMDD') AS DTPEDIDO6,
NVL(TOP.AD_TIPPEDIDOEDIPHARMA,LPAD('001',3,0)) AS TIPOPEDIDO7,
LPAD(1154,20,0) AS NRLISTAPRECO8,
LPAD(' ',13,' ') AS EAN_CLIENTE9,
LPAD(EMP.CGC,14,0) AS CNPJCOMPRADOR10,
LPAD(' ',13,' ') AS EAN_ENTREGA11,  
LPAD(EMP.RAZAOSOCIAL,35,0) NOMEEMP_ENTREGA12,
UPPER(EEP.TIPO||' '||EEP.NOMEEND||', NR '||EMP.NUMEND) AS END_ENTREGA13,
UPPER(BEP.NOMEBAI) AS BAIRRO_ENTREGA14,
UPPER(REPLACE(CEP.NOMECID,'ó','o')) AS CIDADE_ENTREGA15,
UEP.UF AS UF_ENTREGA16,
EMP.CEP AS CEP_ENTREGA17,
EMP.CGC AS CNPJ_ENTREGA18,
LPAD(EMP.INSCESTAD,20,0) AS IE_ENTREGA19,
LPAD(' ',13,' ') AS EAN_DESFATUR20,
EMP.CGC AS CNPJ_DESFATUR21,
LPAD(' ',13,' ') AS EAN_FORNECEDOR22,
PAR.CGC_CPF AS CNPJ_FORNE23,
(CASE CIF_FOB WHEN 'C' THEN 'CIF' WHEN 'F' THEN 'FOB' END) AS COND_ENTREGA24,
TRIM(REPLACE(TO_CHAR(ROUND(CAB.PERCDESC,2) ,'99999D99'),',','')) AS PERCDESC25, 
TRIM(REPLACE(TO_CHAR(ROUND(CAB.VLRFRETE,2) ,'99999D99'),',','')) AS VLRFRETE26, 
'001' AS TIPOMERC27, 
LPAD(PAR.AD_NRCTEDIPHARMA,25,0) AS NRCONTRATO28,
'220' AS TIPO_URG_PEDIDO29,
LPAD(' ',37,' ') AS FILLER
FROM TGFCAB CAB
INNER JOIN TGFTOP TOP ON (TOP.CODTIPOPER = CAB.CODTIPOPER AND TOP.DHALTER = CAB.DHTIPOPER)
INNER JOIN TGFPAR PAR ON (PAR.CODPARC = CAB.CODPARC)
INNER JOIN TSIEMP EMP ON (EMP.CODEMP = CAB.CODEMP)
INNER JOIN TSIEND EEP ON (EEP.CODEND = EMP.CODEND)
INNER JOIN TSIBAI BEP ON (BEP.CODBAI = EMP.CODBAI)
INNER JOIN TSICID CEP ON (CEP.CODCID = EMP.CODCID)
INNER JOIN TSIUFS UEP ON (UEP.CODUF = CEP.UF)]]></COMSELECT>
            <COLUNAS>
              <COLUNA SEQUENCIA="1" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPOREGISTRO1]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="2" TAMANHO="15" TIPO="F">
                <CAMPO><![CDATA[Dados_Disp.IDENTIFICACAO2]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="3" TAMANHO="8" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.DTENTREGAFIXA3]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="4" TAMANHO="8" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.DTENTREGAFIM4]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="5" TAMANHO="8" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.DTENTREGAINI5]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="6" TAMANHO="8" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.DTPEDIDO6]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="7" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPOPEDIDO7]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="8" TAMANHO="20" TIPO="F">
                <CAMPO><![CDATA[Dados_Disp.NRLISTAPRECO8]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="9" TAMANHO="13" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.EAN_CLIENTE9]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="10" TAMANHO="14" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CNPJCOMPRADOR10]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="11" TAMANHO="13" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.EAN_ENTREGA11]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="12" TAMANHO="35" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.NOMEEMP_ENTREGA12]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="13" TAMANHO="35" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.END_ENTREGA13]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="14" TAMANHO="35" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.BAIRRO_ENTREGA14]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="15" TAMANHO="35" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CIDADE_ENTREGA15]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="16" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.UF_ENTREGA16]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="17" TAMANHO="9" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CEP_ENTREGA17]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="18" TAMANHO="14" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CNPJ_ENTREGA18]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="19" TAMANHO="20" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.IE_ENTREGA19]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="20" TAMANHO="13" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.EAN_DESFATUR20]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="21" TAMANHO="14" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CNPJ_DESFATUR21]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="22" TAMANHO="13" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.EAN_FORNECEDOR22]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="23" TAMANHO="14" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CNPJ_FORNE23]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="24" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.COND_ENTREGA24]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="25" TAMANHO="10" TIPO="F">
                <CAMPO><![CDATA[Dados_Disp.PERCDESC25]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="26" TAMANHO="18" TIPO="F">
                <CAMPO><![CDATA[Dados_Disp.VLRFRETE26]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="27" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPOMERC27]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="28" TAMANHO="25" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.NRCONTRATO28]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="29" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPO_URG_PEDIDO29]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="30" TAMANHO="37" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.FILLER]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="31" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
              </COLUNA>
            </COLUNAS>
          </LINHA>
          <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
            <TITULO><![CDATA[REGISTRO 02 - CONDIÇÕES DE PAGAMENTO]]></TITULO>
            <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
            <COMSELECT><![CDATA[SELECT
'02' AS TIPOREGISTRO,
CAB.NUNOTA,
CAB.CODTIPVENDA,
(SELECT COUNT(*) FROM TGFPPG WHERE CODTIPVENDA = CAB.CODTIPVENDA AND CODPARC =0 AND CODTIPTITPAD NOT IN (7)) AS QTDTOTALPARCELAS,
'005' AS CONTAGPRAZOPAGTO, 
'001' AS REFTEMPO,
LPAD (PPG.PRAZO,3,0) AS NRDIASPGTO,
TRIM(REPLACE(TO_CHAR(ROUND(PPG.PERCENTUAL,2) ,'99999D99'),',','')) AS PERPGTOPARC,
LPAD(' ',427,' ') AS FILLER
FROM TGFCAB CAB
INNER JOIN TGFPAR PAR ON (PAR.CODPARC = CAB.CODPARC)
INNER JOIN TSIEMP EMP ON (EMP.CODEMP = CAB.CODEMP)
INNER JOIN TGFTPV TPV ON (TPV.CODTIPVENDA = CAB.CODTIPVENDA AND TPV.DHALTER = CAB.DHTIPVENDA)
INNER JOIN TGFPPG PPG ON (PPG.CODTIPVENDA = CAB.CODTIPVENDA AND PPG.CODPARC =0 AND CODTIPTITPAD NOT IN (7))
INNER JOIN TGFTOP TOP ON (TOP.CODTIPOPER = CAB.CODTIPOPER AND TOP.DHALTER = CAB.DHTIPOPER)]]></COMSELECT>
            <COLUNAS>
              <COLUNA SEQUENCIA="1" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPOREGISTRO]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="2" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.QTDTOTALPARCELAS]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="3" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CONTAGPRAZOPAGTO]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="4" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.REFTEMPO]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="5" TAMANHO="3" TIPO="C">
                <CAMPO><![CDATA[Dados_Disp.NRDIASPGTO]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="6" TAMANHO="10" TIPO="C">
                <CAMPO><![CDATA[Dados_Disp.PERPGTOPARC]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="7" TAMANHO="427" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.FILLER]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="8" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
              </COLUNA>
            </COLUNAS>
          </LINHA>
          <LINHA ANALITICO="S" ORDENAR="N" FICHA="N" ARQPORLINHA="N" UTILIZASEQALT="N" UTILIZASEQINFO="N" INICARQREM="COB">
            <TITULO><![CDATA[REGISTRO 03 - ITENS DO PEDIDO]]></TITULO>
            <FILTRO><![CDATA[CAB.NUNOTA = [NUNOTA]]]></FILTRO>
            <COMSELECT><![CDATA[SELECT
ITE.NUNOTA,
'03' AS TIPOREGISTRO1,
ITE.SEQUENCIA AS NRLINHAITEM2,
NVL(RPAD(PRO.REFERENCIA,14,' '),'              ') AS CODBARRASITEM3,
'EN ' AS TIPOCODBARRAS4,
LPAD(ITE.QTDNEG,15,0) AS QTDNEG5,
ITE.CODVOL,
'001' AS TIPOPEDIDO7,
TRIM(REPLACE(TO_CHAR(ROUND(ITE.VLRUNIT,2) ,'99999D99'),',','')) AS VLRUNIT8,
TRIM(REPLACE(TO_CHAR(ROUND(ITE.VLRUNIT,2) ,'99999D99'),',','')) AS VLRUNITBASE9,
'   ' AS UNMEDIDAPRECO10,
TRIM(REPLACE(TO_CHAR(ROUND(ITE.PERCDESC,2) ,'99999D99'),',','')) AS PERCDESC11, 
'001' AS TIPOUSOMERC12, 
LPAD(' ',364,' ') AS FILLER
FROM TGFCAB CAB
INNER JOIN TGFITE ITE ON (ITE.NUNOTA = CAB.NUNOTA)
INNER JOIN TGFPRO PRO ON (PRO.CODPROD = ITE.CODPROD)
INNER JOIN TGFPAR PAR ON (PAR.CODPARC = CAB.CODPARC)
INNER JOIN TSIEMP EMP ON (EMP.CODEMP = CAB.CODEMP)
INNER JOIN TGFTOP TOP ON (TOP.CODTIPOPER = CAB.CODTIPOPER AND TOP.DHALTER = CAB.DHTIPOPER)]]></COMSELECT>
            <COLUNAS>
              <COLUNA SEQUENCIA="1" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPOREGISTRO1]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="2" TAMANHO="6" TIPO="C">
                <CAMPO><![CDATA[Dados_Disp.NRLINHAITEM2]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="3" TAMANHO="14" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CODBARRASITEM3]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="4" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPOCODBARRAS4]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="5" TAMANHO="15" TIPO="A">
                <CAMPO><![CDATA[Dados_Disp.QTDNEG5]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="6" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.CODVOL]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="7" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPOPEDIDO7]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="8" TAMANHO="15" TIPO="A">
                <CAMPO><![CDATA[Dados_Disp.VLRUNIT8]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="9" TAMANHO="9" TIPO="A">
                <CAMPO><![CDATA[Dados_Disp.VLRUNITBASE9]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="10" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.UNMEDIDAPRECO10]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="11" TAMANHO="10" TIPO="A">
                <CAMPO><![CDATA[Dados_Disp.PERCDESC11]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="12" TAMANHO="3" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.TIPOUSOMERC12]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="13" TAMANHO="364" TIPO="E">
                <CAMPO><![CDATA[Dados_Disp.FILLER]]></CAMPO>
              </COLUNA>
              <COLUNA SEQUENCIA="14" TAMANHO="2" TIPO="E">
                <CAMPO><![CDATA[FIMLINHA]]></CAMPO>
              </COLUNA>
            </COLUNAS>
          </LINHA>
        </LINHAS>
      </LINHA>
    </LINHAS>
  </LAYOUT>
</LAYOUTS>

